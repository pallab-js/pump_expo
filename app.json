{
  "expo": {
    "name": "FuelPump Manager",
    "slug": "fuelpump-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fuelpump",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pallabjs.fuelpumpmanager",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock FuelPump Manager instead of entering your PIN."
      }
    },
    "android": {
      "package": "com.pallabjs.fuelpumpmanager"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock FuelPump Manager instead of entering your PIN."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
